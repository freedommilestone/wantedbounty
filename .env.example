# Copy to .env.local and fill in.

# SPL mint address of the $BERI token on Solana mainnet.
VITE_BERI_MINT=GbYRS9bPStDoDCHtgc4PpuguaMAhux5s3qA2LAgxFXzt

# Wallet that receives the $5 poster fee on Solana.
VITE_TREASURY_ADDRESS=3CQ2GbBy1ks8kyEpa89TV9b3LaC17FBhwR2iZUzVw4pP

# Optional. Leave blank to use the same-origin proxy (`/solana-rpc` locally, `/api/solana-rpc` live).
# Set this only if you want a dedicated RPC (Helius, QuickNode, Triton…).
VITE_SOLANA_RPC_URL=

# Server-only variables: never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CHATGPT_API_SECRET_KEY=
# Optional dedicated server RPC; otherwise uses Solana's public mainnet endpoint.
SOLANA_RPC_URL=
# Optional image-edit model override. Default: gpt-image-2.
OPENAI_IMAGE_MODEL=

# Copy to .env.local and fill in.

# SPL mint address of the $BERI token on Solana mainnet.
VITE_BERI_MINT=GbYRS9bPStDoDCHtgc4PpuguaMAhux5s3qA2LAgxFXzt

# Required for a deployed site. The public mainnet endpoint rejects browser requests (403), so use
# your own RPC (Helius, QuickNode, Triton…). `npm run dev` uses a local proxy instead.
VITE_SOLANA_RPC_URL=

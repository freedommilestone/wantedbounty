# Copy to .env.local and fill in.

# SPL mint address of the $BERI token on Solana mainnet.
VITE_BERI_MINT=

# Required in production. The public mainnet endpoint rejects browser requests (403), so use a
# dedicated RPC (Helius, QuickNode, Triton…). In `npm run dev` it falls back to a local proxy.
VITE_SOLANA_RPC_URL=
